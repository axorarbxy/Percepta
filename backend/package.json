{
  "name": "percepta-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "wrangler dev",
    "dev:node": "tsx --env-file=.dev.vars watch src/node-server.ts",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "tsx --env-file=.dev.vars scripts/test-endpoints.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.6",
    "@hono/zod-validator": "^0.9.1",
    "@neondatabase/serverless": "^0.10.4",
    "drizzle-orm": "^0.40.0",
    "hono": "^5.0.0-rc.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250224.0",
    "@types/node": "^22.13.8",
    "drizzle-kit": "^0.30.5",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "wrangler": "^3.111.0"
  }
}
